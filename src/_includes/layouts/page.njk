---
layout: layouts/base.njk
---
{#-
  Standard content page.
  Front matter: title, kicker (small label above the title), lead (intro sentence),
  wide (true = content may use the full page width instead of a reading column)
-#}
<header class="page-header">
  <div class="container">
    {% if kicker %}<p class="kicker">{{ kicker }}</p>{% endif %}
    <h1>{{ title }}</h1>
    {% if lead %}<p class="lead">{{ lead }}</p>{% endif %}
  </div>
</header>

<div class="container page-body">
  <div class="prose{% if wide %} prose--wide{% endif %}">
    {{ content | safe }}
  </div>
</div>
