<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__about">
        <a class="brand brand--footer" href="/">
          {% include "components/logo-mark.njk" %}
          <span class="brand__name">AI &amp; People <span class="brand__name-sub">at Work</span></span>
        </a>
        <p>{{ site.tagline }}.</p>
        <p>A project of the <a href="{{ site.organisation.url }}">{{ site.organisation.unit }}, {{ site.organisation.name }}</a>, powered by <a href="{{ site.hub.url }}">{{ site.hub.name }}</a>.</p>
      </div>

      {%- for column in navigation.footer %}
      <nav class="site-footer__col" aria-label="{{ column.heading }}">
        <h2 class="site-footer__heading">{{ column.heading }}</h2>
        <ul>
          {%- for link in column.links %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
      {%- endfor %}
    </div>

    <div class="site-footer__bottom">
      <p>© {% year %} {{ site.organisation.name }}</p>
      <p class="site-footer__privacy">No cookies. No tracking. <a href="/privacy/">Privacy</a></p>
      {%- set socials = site.social | selectattr("url") %}
      {%- if socials.length %}
      <ul class="site-footer__social" aria-label="Social media">
        {%- for s in socials %}
        <li><a href="{{ s.url }}" rel="me noopener">{{ s.name }}</a></li>
        {%- endfor %}
      </ul>
      {%- endif %}
    </div>
  </div>
</footer>
