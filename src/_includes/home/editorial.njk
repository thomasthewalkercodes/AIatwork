{#-
  Homepage – Option A "Editorial"
  Calm, report-like, credible. Serif headlines, warm paper background, deep crimson.
  Texts come from src/_data/home.yaml. Styles: src/assets/css/themes/editorial.css
-#}
<section class="ed-hero" aria-labelledby="hero-title">
  <div class="container ed-hero__grid">
    <div class="ed-hero__text">
      <p class="kicker">{{ home.hero.kicker }}</p>
      <h1 id="hero-title" class="ed-hero__title">{{ home.hero.title }}</h1>
      <p class="lead">{{ home.hero.lead }}</p>
      <div class="button-row">
        <a class="button button--primary" href="{{ home.hero.primary.url }}">{{ home.hero.primary.label }}</a>
        <a class="button button--link" href="{{ home.hero.secondary.url }}">{{ home.hero.secondary.label }}</a>
      </div>
    </div>

    <aside class="ed-quiz" aria-labelledby="ed-quiz-title">
      <p class="ed-quiz__kicker">{{ home.selfcheck.kicker }} · Question 1</p>
      <p class="ed-quiz__question">{{ home.selfcheck.sampleQuestion }}</p>
      <ul class="ed-quiz__options" aria-hidden="true">
        {%- for option in selfcheck.scales.frequency | reverse %}{% if loop.index <= 4 %}
        <li>{{ option }}</li>
        {%- endif %}{% endfor %}
      </ul>
      <h2 id="ed-quiz-title" class="ed-quiz__title"><a href="/self-check/">{{ home.selfcheck.title }}</a></h2>
      <p class="ed-quiz__text">{{ home.selfcheck.text }}</p>
    </aside>
  </div>
</section>

<section class="ed-glance container" aria-labelledby="glance-title">
  <h2 id="glance-title" class="ed-section-label">At a glance</h2>
  <ul class="ed-glance__list">
    {%- for h in home.highlights %}
    <li>
      <p class="ed-glance__value">{{ h.value }}</p>
      <p class="ed-glance__label">{{ h.label }}</p>
      <a class="ed-glance__link" href="{{ h.url }}">Read more<span class="visually-hidden">: {{ h.label }}</span></a>
    </li>
    {%- endfor %}
  </ul>
</section>

<section class="ed-levels" aria-labelledby="levels-title">
  <div class="container">
    <div class="ed-levels__head">
      <p class="kicker">{{ home.levels.kicker }}</p>
      <h2 id="levels-title">{{ home.levels.title }}</h2>
      <p>{{ home.levels.text }}</p>
    </div>
    <ol class="ed-levels__list">
      {%- for level in home.levels.items %}
      <li>
        <a href="{{ level.url }}"><span class="ed-levels__name">{{ level.name }}</span></a>
        <span class="ed-levels__text">{{ level.text }}</span>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="ed-contents container" aria-labelledby="themes-title">
  <div class="ed-contents__head">
    <p class="kicker">{{ home.themes.kicker }}</p>
    <h2 id="themes-title">{{ home.themes.title }}</h2>
    <p class="muted">{{ home.themes.text }}</p>
  </div>
  <ol class="ed-toc">
    {%- for item in collections.themes %}
    <li class="ed-toc__item{% if item.data.status == 'upcoming' %} is-upcoming{% endif %}">
      <span class="ed-toc__num">{{ item.data.order | pad }}</span>
      <div class="ed-toc__body">
        <h3 class="ed-toc__title">
          {%- if item.url %}<a href="{{ item.url }}">{{ item.data.title }}</a>{% else %}{{ item.data.title }}{% endif -%}
        </h3>
        <p class="ed-toc__summary">{{ item.data.summary }}</p>
      </div>
      <span class="ed-toc__level">{{ item.data.availableFrom if item.data.status == 'upcoming' else (item.data.level or 'Overview') }}</span>
    </li>
    {%- endfor %}
  </ol>
</section>

<section class="ed-split container" aria-label="Regions and report">
  <article class="ed-split__map">
    <p class="kicker">{{ home.map.kicker }}</p>
    <h2>{{ home.map.title }}</h2>
    <p>{{ home.map.text }}</p>
    <div class="ed-map-ph" aria-hidden="true"><span>Interactive map – coming soon</span></div>
    <a class="button button--link" href="{{ home.map.url }}">{{ home.map.cta }}</a>
  </article>
  <article class="ed-split__report">
    <div class="ed-cover" aria-hidden="true">
      <span class="ed-cover__title">AI &amp; People<br>at Work</span>
      <span class="ed-cover__meta">Report {{ site.report.published }} · {{ site.report.wave }}</span>
    </div>
    <div>
      <p class="kicker">{{ home.report.kicker }}</p>
      <h2>{{ home.report.title }}</h2>
      <p>{{ home.report.text }}</p>
      <a class="button button--primary" href="/report/">{{ home.report.cta }}</a>
    </div>
  </article>
</section>

<section class="ed-newsletter container" aria-labelledby="nl-title">
  <div>
    <h2 id="nl-title">{{ home.newsletter.title }}</h2>
    <p>{{ home.newsletter.text }}</p>
  </div>
  <a class="button button--ghost" href="/newsletter/">{{ home.newsletter.cta }}</a>
</section>
